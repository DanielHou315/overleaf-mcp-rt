{
  "name": "overleaf-mcp-rt",
  "version": "2.0.0",
  "description": "Real-time MCP server for Overleaf: self-hosted Community Edition / Server Pro and overleaf.com. Lets AI coding agents read, edit, comment on and compile LaTeX projects through Overleaf's native operational-transform pipeline, live alongside people in the browser. No git-bridge required.",
  "license": "AGPL-3.0-or-later",
  "author": "Daniel Hou (https://github.com/DanielHou315)",
  "homepage": "https://github.com/DanielHou315/overleaf-mcp-rt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielHou315/overleaf-mcp-rt.git"
  },
  "bugs": {
    "url": "https://github.com/DanielHou315/overleaf-mcp-rt/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "overleaf",
    "sharelatex",
    "latex",
    "operational-transform",
    "real-time",
    "claude-code",
    "ai",
    "cursor",
    "codex",
    "agent-skills",
    "plugin"
  ],
  "type": "module",
  "bin": {
    "overleaf-mcp-rt": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "skills",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:live:matrix": "bash test/live/run-matrix.sh",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/diff": "^7.0.2",
    "@types/fast-diff": "^1.2.2",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "diff": "^9.0.0",
    "esbuild": "^0.28.0",
    "fast-diff": "^1.3.0",
    "msw": "^2.4.0",
    "node-html-parser": "^7.0.0",
    "patch-package": "^8.0.1",
    "socket.io-client": "github:overleaf/socket.io-client#0.9.17-overleaf-5",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
