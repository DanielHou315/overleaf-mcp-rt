# Overleaf CE 4.x (SHARELATEX_* variable names; 5.x refuses to start if it sees them).
SHARELATEX_APP_NAME=overleaf-mcp-rt live test (throw-away)
SHARELATEX_MONGO_URL=mongodb://mongo/sharelatex?replicaSet=overleaf
SHARELATEX_REDIS_HOST=redis
REDIS_HOST=redis
SHARELATEX_SITE_URL=http://sharelatex
ENABLED_LINKED_FILE_TYPES=
ENABLE_CONVERSIONS=true
EMAIL_CONFIRMATION_DISABLED=true
